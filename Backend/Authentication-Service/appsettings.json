{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/authentication-service.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Authentication-Service"
    }
  },
  "Database": {
    "ConnectionString": "Server=localhost;Port=5433;Database=auth;User=postgres;Password=postgrespassword;",
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30,
    "EnableQuerySplitting": true,
    "PoolSize": 128,
    "EnableHealthChecks": true,
    "HealthCheckInterval": 5
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "43191005A866786C6F336369224437356B657771674B584D4C38366946595273",
    "Issuer": "HungryMan-Authentication-Service",
    "Audience": "HungryMan-Users",
    "TokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  }
}