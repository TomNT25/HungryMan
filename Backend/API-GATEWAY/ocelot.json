{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v{version}/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hungryman-authentication-service",
          "Port": 5142
        }
      ],
      "UpstreamPathTemplate": "/api/v{version}/auth/{everything}",
      "UpstreamMethods": [ "Get", "Post", "Put", "Delete", "Options" ],
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 5
      }
    },
    {
      "DownstreamPathTemplate": "/api/v{version}/products/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5189
        },
        {
          "Host": "localhost",
          "Port": 5190
        }
      ],
      "UpstreamPathTemplate": "/api/v{version}/products/{everything}",
      "UpstreamMethods": [ "Get", "Post", "Put", "Delete", "Options" ],
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 100
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5132",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "API Gateway: Rate limit exceeded. Please try again later.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Forwarded-For"
    }
  }
}
